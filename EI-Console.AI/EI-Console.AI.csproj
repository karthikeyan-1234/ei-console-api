<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>EI_Console.AI</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<NoWarn>$(NoWarn);SKEXP0010</NoWarn>
		<NoWarn>$(NoWarn);SKEXP0001</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
		<!-- Bump version from 10.0.9 to 10.0.10 -->
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="OpenAI" Version="2.14.0" />
		<PackageReference Include="ModelContextProtocol" Version="2.2.0" />

		<PackageReference Include="Microsoft.SemanticKernel" Version="1.30.0" />
		<PackageReference Include="Microsoft.SemanticKernel.Agents.Core" Version="1.30.0" />
	</ItemGroup>
</Project>